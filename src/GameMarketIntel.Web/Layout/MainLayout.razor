@inherits LayoutComponentBase

<div class="@ShellCssClass"@onkeydown="HandleKeyDown">

    <header class="application-header">
        <div class="application-header__left">
            <button type="button"
                    class="icon-button application-header__menu-button application-header__menu-button--mobile"
                    aria-label="@MobileMenuButtonLabel"
                    aria-expanded="@IsMobileDrawerOpen"
                    aria-controls="application-navigation"
                    @onclick="ToggleMobileDrawer">
                @if (IsMobileDrawerOpen)
                {
                    <svg viewBox="0 0 24 24"aria-hidden="true">
                        <path d="M6 6 18 18M18 6 6 18" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 7H20M4 12H20M4 17H20" />
                    </svg>
                }
            </button>

            <button type="button"
                    class="icon-button application-header__menu-button application-header__menu-button--desktop"
                    aria-label="@DesktopMenuButtonLabel"
                    aria-expanded="@(!IsDesktopSidebarCollapsed)"
                    aria-controls="application-navigation"
                    @onclick="ToggleDesktopSidebar">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7H20M4 12H20M4 17H20" />
                </svg>
            </button>

            <a class="product-identity" href="/" aria-label="Game Market Intelligence home">
                <span class="product-identity__mark" aria-hidden="true">
                    GM
                </span>

                <span class="product-identity__name"> Game Market Intelligence </span>
            </a>
        </div>

     

        <div class="application-header__right"aria-hidden="true"></div>
    </header>

    <aside id="application-navigation"class="application-sidebar"aria-label="Primary navigation">
        <NavMenu IsCompact="@IsDesktopSidebarCollapsed" OnNavigate="CloseMobileDrawer" />
    </aside>

    <main class="application-main">
        <div class="application-content"> @Body </div>

        <footer class="application-footer"> <span>Game Market Intelligence</span>

            <nav aria-label="Footer navigation">
                <a href="/">About</a>

                <a href="/sources">Data Sources</a>

                <a href="https://github.com/" target="_blank" rel="noopener noreferrer"> GitHub

                    <span class="visually-hidden">opens in a new tab</span>
                </a>
            </nav>
        </footer>
    </main>

    @if (IsMobileDrawerOpen)
    {
        <button type="button"
               class="navigation-overlay"
                aria-label="Close navigation"
                @onclick="CloseMobileDrawer">
        </button>
    }
</div>